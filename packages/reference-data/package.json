{
  "name": "@keluargamakan/reference-data",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned Cek Aman reference dataset: build format, content hash and the verified loader the API uses (DAT-06, SAF-13).",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@keluargamakan/cek-aman": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "vitest": "5.1.0"
  }
}
