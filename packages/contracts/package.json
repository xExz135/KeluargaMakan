{
  "name": "@keluargamakan/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI contract and generated API clients.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs && node scripts/check-drift.mjs",
    "verify:dart": "node scripts/verify-dart.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "yaml": "2.9.1"
  }
}
