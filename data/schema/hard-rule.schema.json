{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.keluargamakan.example/v1/hard-rule.schema.json",
  "title": "Hard rule",
  "description": "A profile hard rule that is never overridden (PRF-03, PRF-04, PRF-08, SAF-12). Household data: sensitive, encrypted with the health-data key (DAT-02).",
  "oneOf": [
    {
      "title": "Allergy from the PRF-04 standard list",
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "type", "allergen"],
      "properties": {
        "ruleId": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "const": "allergy" },
        "allergen": { "$ref": "common.schema.json#/$defs/standardAllergen" }
      }
    },
    {
      "title": "Halal, vegetarian or vegan",
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "type"],
      "properties": {
        "ruleId": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "enum": ["halal", "vegetarian", "vegan"] }
      }
    },
    {
      "title": "Medical exclusion",
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "type", "freeText", "mapping"],
      "properties": {
        "ruleId": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "const": "medical_exclusion" },
        "freeText": { "type": ["string", "null"] },
        "mapping": { "$ref": "#/$defs/mapping" }
      }
    },
    {
      "title": "Free text, including allergies not on the standard list",
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "type", "freeText", "mapping"],
      "properties": {
        "ruleId": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "const": "free_text" },
        "freeText": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
        "mapping": { "$ref": "#/$defs/mapping" }
      }
    }
  ],
  "$defs": {
    "mapping": {
      "description": "PRF-08: an unmapped or merely proposed mapping always returns \"Check the label\" (SAF-09).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ingredientIds", "confirmedBy"],
          "properties": {
            "status": { "const": "mapped" },
            "ingredientIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/id" }
            },
            "confirmedBy": { "$ref": "common.schema.json#/$defs/mappingConfirmer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "ingredientIds"],
          "properties": {
            "status": { "const": "proposed" },
            "ingredientIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/id" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "unmapped" } }
        }
      ]
    }
  }
}
