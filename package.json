{
  "name": "keluargamakan",
  "private": true,
  "description": "KeluargaMakan monorepo",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint && eslint scripts",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present --filter \"!@keluargamakan/safety-regression\" run test && pnpm run test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:safety": "pnpm --filter @keluargamakan/safety-regression run test",
    "check:fixtures": "node scripts/check-fixture-refs.mjs",
    "validate:reference": "node scripts/validate-reference.mjs",
    "build:reference": "node scripts/build-reference.mjs",
    "check:contracts": "pnpm --filter @keluargamakan/contracts run check",
    "audit:deps": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
