# KeluargaMakan API. Copy to .env for local development; values come from
# Secret Manager in staging and production. Do not commit filled-in values.

# Runtime
NODE_ENV=
# Deployment environment: local, test, staging or production. Missing or
# unknown counts as production (test fixtures refused, pinned hash required).
APP_ENV=
PORT=
LOG_LEVEL=

# PostgreSQL (household and reference data)
DATABASE_URL=

# Redis (cache and BullMQ job queue)
REDIS_URL=

# Internal AI service
AI_SERVICE_URL=
AI_SERVICE_AUTH_TOKEN=

# Built Cek Aman reference dataset (DAT-06, SAF-13), from `pnpm build:reference`.
# The version is read from the verified dataset itself. Outside local and test,
# the SHA-256 the build printed is required, and a path into the test
# fixtures folder is refused.
REFERENCE_DATA_PATH=
REFERENCE_DATA_SHA256=

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=

# Temporary photo storage (SET-05, DAT-03)
PHOTO_BUCKET=
PHOTO_TEMP_PREFIX=

# Key provider for health-data encryption (DAT-02): local or cloud_kms.
# There is no default; the API refuses to start without it.
KEY_PROVIDER=

# Cloud KMS crypto key names (staging and production). Health data and hard
# rules use a separate key from general household data (DAT-02).
KMS_GENERAL_DATA_KEY=
KMS_HEALTH_DATA_KEY=
# Optional deadline for each Cloud KMS call, in milliseconds (default 2000).
KMS_CALL_TIMEOUT_MS=

# Local development only (KEY_PROVIDER=local, refused in production): two
# different random 32-byte keys, base64-encoded, for example from
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
LOCAL_GENERAL_DATA_KEK=
LOCAL_HEALTH_DATA_KEK=

# Database tests against a real PostgreSQL (docker compose). Optional: without
# it the suite runs on PGlite and skips the PostgreSQL target.
TEST_DATABASE_URL=

# Authentication (INT-13)
AUTH_JWT_SIGNING_KEY=
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SIGN_IN_SERVICE_ID=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Push notifications (INT-10)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_SECRET=

# Observability (NFR-21, NFR-06)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
