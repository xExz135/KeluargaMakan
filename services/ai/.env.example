# KeluargaMakan AI service. Copy to .env for local development; values come
# from Secret Manager in staging and production. Do not commit filled-in values.

# Runtime
AI_ENV=
PORT=
LOG_LEVEL=

# Token the API presents on internal calls
AI_SERVICE_AUTH_TOKEN=

# Provider selection (INT-06 to INT-08). Providers are not chosen yet;
# use the mock provider locally and in tests.
VISION_PROVIDER=
LANGUAGE_PROVIDER=
SPEECH_PROVIDER=
VISION_PROVIDER_API_KEY=
LANGUAGE_PROVIDER_API_KEY=
SPEECH_PROVIDER_API_KEY=

# Prompt and model configuration version, recorded with each request
PROMPT_VERSION=

# Observability (NFR-21, AI-09)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
