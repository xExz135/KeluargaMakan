# KeluargaMakan AI service. Copy to .env for local development; values come
# from Secret Manager in staging and production. Do not commit filled-in values.
# Start with: uvicorn --factory app.main:create_app_from_env

# Runtime: local | test | staging | production (required)
AI_ENV=
PORT=
LOG_LEVEL=

# Shared secret the API presents as "Authorization: Bearer <token>", at least
# 32 characters. Set the previous token too while rotating.
AI_SERVICE_AUTH_TOKEN=
AI_SERVICE_AUTH_TOKEN_PREVIOUS=

# ---------- Provider slots (INT-06 to INT-08, AI-12) ----------
# Each capability has a primary slot and an optional backup slot (<CAP>_BACKUP_*).
# Capabilities: VISION, LANGUAGE, SPEECH_TO_TEXT, TEXT_TO_SPEECH (optional:
# text-to-speech runs on the phone).
#   <SLOT>_PROVIDER            mock (local and test only) | disabled | gemini | groq
#                              gemini: VISION, LANGUAGE. groq: LANGUAGE, SPEECH_TO_TEXT.
#   <SLOT>_MODEL_ID            provider model name, from config not code (required
#                              for gemini and groq). Owner decision 2026-11-11:
#                              Gemini Flash / Flash-Lite, Groq as language backup,
#                              Groq whisper-large-v3-turbo for speech-to-text.
#                              Check the providers' model lists for current names.
#   <SLOT>_API_KEY             required for gemini and groq. Never logged or shown
#                              in errors. Locally in services/ai/.env (never
#                              committed); Secret Manager elsewhere.
#   <SLOT>_TIER                free | paid (default free)
#   <SLOT>_TRAINS_ON_INPUTS    true | false (default true). Free tiers may use
#                              requests to improve their products, so a free
#                              slot must stay true; a slot that trains is only
#                              called for a household that opted in (SET-09).
#   <SLOT>_RPM, _RPD, _TPM     the provider's limits for your account. The adapter
#                              keeps a local budget per process and answers "AI
#                              unavailable" (with the fallback) once it is spent,
#                              instead of calling. Empty = no local limit.
#   <SLOT>_ASH, _ASD           speech-to-text audio seconds per hour / per day
#                              (Groq bills each request as at least 10 seconds)
#   <SLOT>_REQUEST_TIMEOUT_SECONDS  seconds for one HTTP attempt (default 30, always
#                              capped by the feature timeout below). Set it shorter
#                              on a primary to leave time for its backup.
#   <SLOT>_MAX_RETRIES         extra attempts after a 5xx or connection error,
#                              0 to 3 (default 1). Never after 429 or a timeout.
#   <SLOT>_MAX_OUTPUT_TOKENS   answer length cap (default 2048)
# Local and test default every required slot to the mock provider.
VISION_PROVIDER=
VISION_MODEL_ID=
VISION_TIER=
VISION_TRAINS_ON_INPUTS=
VISION_RPM=
VISION_RPD=
VISION_TPM=
VISION_REQUEST_TIMEOUT_SECONDS=
VISION_MAX_RETRIES=
VISION_MAX_OUTPUT_TOKENS=
VISION_API_KEY=

LANGUAGE_PROVIDER=
LANGUAGE_MODEL_ID=
LANGUAGE_TIER=
LANGUAGE_TRAINS_ON_INPUTS=
LANGUAGE_RPM=
LANGUAGE_RPD=
LANGUAGE_TPM=
LANGUAGE_REQUEST_TIMEOUT_SECONDS=
LANGUAGE_MAX_RETRIES=
LANGUAGE_MAX_OUTPUT_TOKENS=
LANGUAGE_API_KEY=

LANGUAGE_BACKUP_PROVIDER=
LANGUAGE_BACKUP_MODEL_ID=
LANGUAGE_BACKUP_TIER=
LANGUAGE_BACKUP_TRAINS_ON_INPUTS=
LANGUAGE_BACKUP_RPM=
LANGUAGE_BACKUP_RPD=
LANGUAGE_BACKUP_TPM=
LANGUAGE_BACKUP_REQUEST_TIMEOUT_SECONDS=
LANGUAGE_BACKUP_MAX_RETRIES=
LANGUAGE_BACKUP_MAX_OUTPUT_TOKENS=
LANGUAGE_BACKUP_API_KEY=

SPEECH_TO_TEXT_PROVIDER=
SPEECH_TO_TEXT_MODEL_ID=
SPEECH_TO_TEXT_TIER=
SPEECH_TO_TEXT_TRAINS_ON_INPUTS=
SPEECH_TO_TEXT_RPM=
SPEECH_TO_TEXT_RPD=
SPEECH_TO_TEXT_ASH=
SPEECH_TO_TEXT_ASD=
SPEECH_TO_TEXT_REQUEST_TIMEOUT_SECONDS=
SPEECH_TO_TEXT_MAX_RETRIES=
SPEECH_TO_TEXT_API_KEY=

# Optional slot; leave empty to answer "use on-device speech".
TEXT_TO_SPEECH_PROVIDER=

# ---------- Photos (REC-07, SET-05) ----------
# mock (local and test only) | disabled. Comma-separated HTTPS hosts the
# short-lived photo URLs may come from.
PHOTO_SOURCE=
PHOTO_URL_ALLOWED_HOSTS=

# ---------- Limits, timeouts and thresholds (targets are configuration) ----------
MAX_PHOTOS_PER_REQUEST=
MAX_PHOTO_BYTES=
MAX_AUDIO_BYTES=
RECOGNITION_TIMEOUT_SECONDS=
ADAPTATION_TIMEOUT_SECONDS=
TWEAK_TIMEOUT_SECONDS=
SPEECH_TO_TEXT_TIMEOUT_SECONDS=
TEXT_TO_SPEECH_TIMEOUT_SECONDS=
RECOGNITION_MIN_CONFIDENCE=
ADAPTATION_MIN_CONFIDENCE=
TWEAK_MIN_CONFIDENCE=
SPEECH_TO_TEXT_MIN_CONFIDENCE=

# Prompt templates directory (default services/ai/prompts). Prompt versions
# come from prompts/registry.json and are logged with every call (AI-11).
PROMPTS_DIR=

# Observability (NFR-21, AI-09)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
