<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone through cloud backup or device
     transfer. Session tokens are bound to this phone's Keystore and the
     database holds household data; both stay local (DAT-02, ACC-13). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
